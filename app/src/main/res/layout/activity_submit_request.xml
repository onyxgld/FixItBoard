<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".SubmitRequestActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/navy_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="New Requests"
            android:textColor="@color/navy_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/slate_light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Problem Type"
                android:textColor="@color/navy_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProblemType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_outline"
                android:hint="e.g. Plumbing, Electrical, Aircon"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Location"
                android:textColor="@color/navy_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_outline"
                android:hint="e.g. Kitchen, Bedroom, Unit 3A"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Description"
                android:textColor="@color/navy_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_input_outline"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_above="@id/tvCharCount"
                    android:background="@null"
                    android:gravity="top|start"
                    android:hint="Describe the maintenance issue..."
                    android:inputType="textMultiLine"
                    android:maxLength="300"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCharCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:text="0/300"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Add photos (optional)"
                android:textColor="@color/navy_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <ImageButton
                    android:id="@+id/btnPhoto1"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_outline"
                    android:contentDescription="Add Photo 1"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/navy_primary" />

                <ImageButton
                    android:id="@+id/btnPhoto2"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_outline"
                    android:contentDescription="Add Photo 2"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/navy_primary" />

                <ImageButton
                    android:id="@+id/btnPhoto3"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_outline"
                    android:contentDescription="Add Photo 3"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/navy_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <ImageButton
                    android:id="@+id/btnPhoto4"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_outline"
                    android:contentDescription="Add Photo 4"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/navy_primary" />

                <ImageButton
                    android:id="@+id/btnPhoto5"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginHorizontal="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_outline"
                    android:contentDescription="Add Photo 5"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/navy_primary" />

                <ImageButton
                    android:id="@+id/btnPhoto6"
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_outline"
                    android:contentDescription="Add Photo 6"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:tint="@color/navy_primary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmitRequest"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/navy_primary"
                android:text="Submit Request"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>